# P1 portal 运行参数示例。复制为 .env 后按试点环境修改。
# 注意：secrets 目录中的文件才是凭据真相，这里只放非敏感开关。

# 网关暴露地址（默认只绑定 127.0.0.1，外部访问请由上层负载均衡终止 TLS）
# 如需局域网直连，把 docker-compose.yml 的端口绑定改成 0.0.0.0

# OIDC 为试点必填项：issuer 与 client-id 任一为空，非 dev 分支会拒绝启动
KB_OIDC_ISSUER=https://sso.example.internal/realms/acme
KB_OIDC_CLIENT_ID=kb-p1-portal
KB_OIDC_REDIRECT_URI=https://kb.example.internal:8443/login/oauth2/code/acme
KB_OIDC_JIT_ENABLED=false
KB_COOKIE_SECURE=true
KB_SESSION_COOKIE=kb_session

# 未开放外网时保持 true；接入真实 WeKnora 镜像后仍应保持 true
KB_OFFLINE_ENFORCED=true

# 引擎：试点联调可用 stub；正式改为 weknora 并保留能力探测
KB_ENGINE_PROVIDER=weknora
KB_ENGINE_BASE_URL=http://weknora:8080
KB_ENGINE_CAPABILITY_PROBE=true

# 模型：worker/api 均通过内网 Ollama 调用
KB_OLLAMA_BASE_URL=http://ollama:11434
KB_OLLAMA_EMBED_MODEL=nomic-embed-text
KB_OLLAMA_CHAT_MODEL=deepseek-r1:8b

# 退避与租约（#18）
KB_INGEST_MAX_ATTEMPTS=5
KB_INGEST_BACKOFF_BASE_MS=2000
KB_INGEST_BACKOFF_MAX_MS=300000
KB_INGEST_LEASE_SECONDS=45
KB_INGEST_LEASE_HEARTBEAT=15

# P0 secrets 位置（redis/minio 凭据沿用 P0，避免两套口令）
# KB_P0_SECRETS=../../p0/compose/secrets
# 若 P0 基础设施网络名不同，显式指定
# KB_INFRA_NETWORK=kb-p0_p0-backend
# KB_INGRESS_NETWORK=kb-p0_p0-ingress
